# ==============================================================================
# Askepedia Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local development.
# ==============================================================================

# Spring Environment
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL Configuration (Phase 3+)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=askepedia
DB_USER=postgres
DB_PASSWORD=postgres

# Local AI / Ollama Configuration (Phase 6+)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_CHAT=llama3.2:1b
OLLAMA_MODEL_EMBEDDING=nomic-embed-text
